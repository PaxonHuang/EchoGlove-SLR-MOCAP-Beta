# === V5 Cleanup Additions ===

# ESP-IDF build artifacts
**/build/
sdkconfig.old
# sdkconfig is auto-generated from sdkconfig.defaults + menuconfig; track only .defaults
**/sdkconfig
# managed_components are auto-fetched from idf_component.yml + dependencies.lock
# (like node_modules — do NOT commit). dependencies.lock IS committed for reproducibility.
**/managed_components/

# Diagnostic temp files
*.diag_*
*.back

# Session continuation dumps (Claude Code)
2026-*-this-session-*.txt
2026-*-command-message*.txt
temp_search.txt

# Claude Code local session log directory (ephemeral transcripts)
log/

# Graphify working output (semantic-extraction cache; rebuildable)
graphify-out/

# Claude Code in-session plan scratch (kept locally only)
.claude/plans/

# Binary archives (don't store in git)
*.zip
*.rar

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# External competitor reference screenshots (Noitom PN3 etc.) stay OUTSIDE the
# repo in the parent dir as local reference only. Listed in case copied in.
/pn3-full.png
/pnstudio-spec.png
