/*
 * BNO085 Sensor Data Test — Adafruit BNO08x Library
 *
 * Wiring (ESP32-S3-DevKitC-1 N16R8):
 *   VCC → 3.3V
 *   GND → GND
 *   SDA → GPIO8
 *   SCL → GPIO9
 *   CS  → 3.3V
 *   PS0 → GND (I2C mode)
 *   PS1 → GND (I2C mode)
 *   ADO → 3.3V (address 0x4B)
 *   RST → GPIO10 (or 3.3V if not needed)
 *
 * Expected output:
 *   - I2C scan finds 0x4B
 *   - BNO085 initializes successfully
 *   - Rotation vector, accelerometer, gyroscope data streams
 */

#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_BNO08x.h>

#define SDA_PIN 8
#define SCL_PIN 9
#define RST_PIN 10
#define BNO_ADDR 0x4B

Adafruit_BNO08x bno;
sh2_SensorValue_t sensorValue;

// Track last report for each sensor
unsigned long lastRotVecPrint = 0;
unsigned long lastAccelPrint = 0;
unsigned long lastGyroPrint = 0;

void printSensorData(sh2_SensorValue_t &val) {
    switch (val.sensorId) {
        case SH2_ROTATION_VECTOR:
            Serial.printf("[ROT] r=(%.3f, %.3f, %.3f, %.3f) accuracy=%.2f\n",
                val.un.rotationVector.real,
                val.un.rotationVector.i,
                val.un.rotationVector.j,
                val.un.rotationVector.k,
                val.un.rotationVector.accuracy);
            break;
        case SH2_ACCELEROMETER:
            Serial.printf("[ACC] x=%.3f y=%.3f z=%.3f m/s^2\n",
                val.un.accelerometer.x,
                val.un.accelerometer.y,
                val.un.accelerometer.z);
            break;
        case SH2_GYROSCOPE_CALIBRATED:
            Serial.printf("[GYR] x=%.3f y=%.3f z=%.3f rad/s\n",
                val.un.gyroscope.x,
                val.un.gyroscope.y,
                val.un.gyroscope.z);
            break;
        case SH2_MAGNETIC_FIELD_CALIBRATED:
            Serial.printf("[MAG] x=%.3f y=%.3f z=%.3f uT\n",
                val.un.magneticField.x,
                val.un.magneticField.y,
                val.un.magneticField.z);
            break;
        default:
            Serial.printf("[OTHER] sensorId=%d\n", val.sensorId);
            break;
    }
}

void setup() {
    Serial.begin(115200);
    delay(1000);

    Serial.println("\n========================================");
    Serial.println("  BNO085 Sensor Data Test");
    Serial.println("========================================\n");

    // --- I2C Scan ---
    Serial.println("[1] I2C scan...");
    Wire.begin(SDA_PIN, SCL_PIN);
    Wire.setClock(400000);

    bool found = false;
    for (byte addr = 1; addr < 127; addr++) {
        Wire.beginTransmission(addr);
        if (Wire.endTransmission() == 0) {
            Serial.printf("  Found: 0x%02X", addr);
            if (addr == BNO_ADDR) Serial.print(" [BNO085]");
            Serial.println();
            found = true;
        }
    }
    if (!found) {
        Serial.println("[FAIL] No I2C devices found!");
        Serial.println("Check wiring: SDA=GPIO8, SCL=GPIO9");
        while (1) delay(1000);
    }

    // --- RST Pin Check ---
    Serial.println("\n[2] RST pin check (GPIO10):");
    pinMode(RST_PIN, INPUT_PULLDOWN);
    int rstState = digitalRead(RST_PIN);
    Serial.printf("  GPIO10 with pull-down = %s\n", rstState ? "HIGH" : "LOW");
    if (rstState == HIGH) {
        Serial.println("  [WARN] RST is HARD HIGH — software reset unavailable");
        Serial.println("         Use power cycle (disconnect VCC) to reset BNO085");
    } else {
        Serial.println("  [OK] RST is controllable");
    }

    // --- BNO085 Init ---
    Serial.println("\n[3] Initializing BNO085 (Adafruit library)...");
    if (!bno.begin_I2C(BNO_ADDR)) {
        Serial.println("[FAIL] BNO085 init failed!");
        Serial.println("Try: disconnect VCC for 10 seconds, then reconnect");
        while (1) delay(1000);
    }
    Serial.println("[OK] BNO085 initialized!");

    // --- Enable Sensors ---
    Serial.println("\n[4] Enabling sensors...");
    if (!bno.enableReport(SH2_ROTATION_VECTOR, 5000)) {  // 5ms = 200Hz
        Serial.println("[WARN] Rotation vector enable failed");
    } else {
        Serial.println("  [OK] Rotation vector (200Hz)");
    }
    if (!bno.enableReport(SH2_ACCELEROMETER, 10000)) {  // 10ms = 100Hz
        Serial.println("[WARN] Accelerometer enable failed");
    } else {
        Serial.println("  [OK] Accelerometer (100Hz)");
    }
    if (!bno.enableReport(SH2_GYROSCOPE_CALIBRATED, 10000)) {  // 10ms = 100Hz
        Serial.println("[WARN] Gyroscope enable failed");
    } else {
        Serial.println("  [OK] Gyroscope (100Hz)");
    }

    Serial.println("\n[5] Reading sensor data (Ctrl+C to stop)...\n");
}

void loop() {
    if (bno.getSensorEvent(&sensorValue)) {
        unsigned long now = millis();
        printSensorData(sensorValue);
    }
    delay(1);  // Yield to RTOS
}
